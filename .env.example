# =============================================
# MetroMail: Jonathan Simpson & Co.
# Copy to .env.local and fill in real values.
# =============================================

# MongoDB connection string (Mongoose + Better Auth share this)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/metromail

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Resend webhook signing secret: shown when you add a webhook for `email.received`
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Better Auth secret: at least 32 chars, high entropy: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change_me_32_chars_minimum

# Base URL used by Better Auth for cookies/CSRF. In production use the
# deployed HTTPS origin (e.g. https://mail.jonathansimpson.co).
BETTER_AUTH_URL=http://localhost:3000

# Public base URL of this app: embedded in outbound emails (logo + links).
# MUST be the production origin when deployed.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated allowlist of emails permitted to sign up (internal tool)
ALLOWED_EMAILS=lewis@example.com,devano@example.com

# Per-sender daily outbound cap (counted per From address)
SEND_DAILY_LIMIT=100

# Soft send-guard ceiling for cold outreach: confirms before sending once
# today's volume reaches this number or 50% of SEND_DAILY_LIMIT
SEND_COLD_CEILING=30

# Optional: fallback forward destination when no routing rule matches
FALLBACK_FORWARD_TO=
